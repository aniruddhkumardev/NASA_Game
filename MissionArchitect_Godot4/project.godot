[rendering]

textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.08, 1)
# Crisp visuals: 4x MSAA for geometry edges + stronger anisotropic filtering
# so distant surfaces stay sharp instead of smearing at grazing angles.
anti_aliasing/quality/msaa_3d=2
anisotropic_filtering_level=8
