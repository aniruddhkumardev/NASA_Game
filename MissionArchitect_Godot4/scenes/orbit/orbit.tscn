[sub_resource type="Shader" id="Shader_earth_surface"]
code = "shader_type spatial;\nrender_mode diffuse_burley, specular_schlick_ggx;\nfloat hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }\nfloat noise(vec2 p) { vec2 i=floor(p); vec2 f=fract(p); f=f*f*(3.0-2.0*f); return mix(mix(hash(i),hash(i+vec2(1.,0.)),f.x),mix(hash(i+vec2(0.,1.)),hash(i+vec2(1.,1.)),f.x),f.y); }\nvoid fragment(){ vec2 uv=UV; float n=noise(uv*5.0)+0.5*noise(uv*11.0)+0.25*noise(uv*22.0); float land=smoothstep(0.92,1.12,n); vec3 ocean=mix(vec3(0.006,0.025,0.11),vec3(0.015,0.20,0.55),pow(1.0-abs(uv.y-0.5)*1.7,1.5)); vec3 ground=mix(vec3(0.03,0.14,0.06),vec3(0.34,0.25,0.08),smoothstep(1.04,1.35,n)); ALBEDO=mix(ocean,ground,land); METALLIC=0.0; ROUGHNESS=0.48; EMISSION=ocean*0.22; }"

